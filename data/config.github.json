{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "finance-news",
    "profile_settings": {
      "finance-news": { "threshold": 3.0, "topic_dedup": true }
    }
  },
  "sources": {
    "github": [],
    "hackernews": { "enabled": false, "fetch_top_stories": 30, "min_score": 150, "profile": "finance-news" },
    "rss": [
      { "name": "CNBC Finance", "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664", "enabled": true, "category": "finance", "profile": "finance-news", "content_extractor": "trafilatura" },
      { "name": "Investing.com - Commodities", "url": "https://www.investing.com/rss/news_11.rss", "enabled": true, "category": "commodities", "profile": "finance-news", "content_extractor": "trafilatura" },
      { "name": "Kitco News", "url": "https://www.kitco.com/rss/", "enabled": true, "category": "gold", "profile": "finance-news", "content_extractor": "trafilatura" },
      { "name": "FXStreet News", "url": "https://www.fxstreet.com/rss/news", "enabled": true, "category": "forex", "profile": "finance-news", "content_extractor": "trafilatura" },
      { "name": "DailyFX", "url": "https://www.dailyfx.com/feeds/all", "enabled": true, "category": "forex", "profile": "finance-news", "content_extractor": "trafilatura" },
      { "name": "MarketWatch Top Stories", "url": "http://feeds.marketwatch.com/marketwatch/topstories/", "enabled": true, "category": "markets", "profile": "finance-news", "content_extractor": "trafilatura" }
    ],
    "reddit": { "enabled": false, "subreddits": [], "users": [], "fetch_comments": 0 },
    "telegram": { "enabled": false, "channels": [] }
  },
  "collection": { "time_window_hours": 24 },
  "digest": {
    "max_items": null,
    "profile_order": ["finance-news"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "headers": ""
  }
}
